[Unit]
Description=KAI-Kiosk — Konfigurationsdienst (lokale Web-Oberfläche)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/kai-kiosk
Environment=KAI_KIOSK_CONFIG=/etc/kai-kiosk/config.json
Restart=always
RestartSec=3
# root: schreibt NetworkManager-Keyfile (feste IP) und darf das Gerät neu starten.
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
