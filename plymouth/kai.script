# KAI-Kiosk Boot-Splash: KAI-Logo mittig auf hellem KAI-Papier-Hintergrund + drehender Teal-Ring.
# Reines Script-Thema (keine externen Frames) — der Ring entsteht durch Drehen EINES Bildes.

# Hintergrund: KAI-Papier hell (#F3F1EA) — passt nahtlos zur hellen KAI-Anmeldemaske danach.
Window.SetBackgroundTopColor(0.953, 0.945, 0.918);
Window.SetBackgroundBottomColor(0.953, 0.945, 0.918);

logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 50);
logo.sprite.SetZ(1);

spinner.image = Image("spinner.png");
spinner.sprite = Sprite();
spinner.sprite.SetZ(2);
spinner.cx = Window.GetWidth()  / 2;
spinner.cy = Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 20;
spinner.angle = 0;

fun refresh() {
    spinner.angle += 0.12;
    if (spinner.angle > 6.2832) spinner.angle -= 6.2832;
    rotated = spinner.image.Rotate(spinner.angle);
    spinner.sprite.SetImage(rotated);
    spinner.sprite.SetX(spinner.cx - rotated.GetWidth()  / 2);
    spinner.sprite.SetY(spinner.cy - rotated.GetHeight() / 2);
}
Plymouth.SetRefreshFunction(refresh);

# Passworteingabe (falls je nötig) schlicht halten — Kiosk hat i. d. R. keine.
fun display_password_callback(prompt, bullets) { }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
